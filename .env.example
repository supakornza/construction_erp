# Django Configuration
# Generate SECRET_KEY with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-your-generated-secret-key-here

# Debug Mode (MUST be False in production)
DEBUG=True

# Database Configuration
# Development: sqlite:///db.sqlite3
# Production: postgres://user:password@host:port/dbname
DATABASE_URL=sqlite:///db.sqlite3

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Security Settings (for production)
# SESSION_COOKIE_SECURE=True
# SESSION_COOKIE_HTTPONLY=True
# CSRF_COOKIE_SECURE=True

# API Configuration
# API_THROTTLE_RATE=1000/day

# n8n / LINE Bot integration token
ERP_DIGEST_SECRET=your-secret-token-here
